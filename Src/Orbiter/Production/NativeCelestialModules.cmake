    orbiter_stage_core_runtime(production_native_planet_observer)
    add_executable(production_native_elevation_observer "${CMAKE_CURRENT_LIST_DIR}/../../../Tests/Production/Elevation/NativeObserve.cpp")
    target_link_libraries(production_native_elevation_observer PRIVATE orbiter_production_boundary)
