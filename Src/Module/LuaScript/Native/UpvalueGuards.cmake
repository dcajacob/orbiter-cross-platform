# Build a checked native copy; never patch the downloaded original source tree.
function(orbiter_native_lua_upvalues original_dir output_dir result)
    set(lock "${ORBITER_SOURCE_ROOT}/Tests/Production/NativeLua/upvalue-source.lock.json")
    file(READ "${lock}" declaration)
    string(JSON schema GET "${declaration}" schema)
    string(JSON count LENGTH "${declaration}" original_files_sha256)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unknown native Lua upvalue declaration")
    endif()
    file(GLOB actual_inputs "${original_dir}/*.c" "${original_dir}/*.h")
    list(LENGTH actual_inputs actual_count)
    if(NOT actual_count EQUAL count)
        message(FATAL_ERROR "Original Lua source input set differs")
    endif()
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON name MEMBER "${declaration}" original_files_sha256 ${index})
        if(NOT name MATCHES "^[A-Za-z0-9_]+[.][ch]$" OR IS_SYMLINK "${original_dir}/${name}")
            message(FATAL_ERROR "Invalid original Lua source path")
        endif()
        string(JSON expected GET "${declaration}" original_files_sha256 "${name}")
        file(SHA256 "${original_dir}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Original Lua source differs: ${name}")
        endif()
    endforeach()
    file(READ "${original_dir}/lfunc.c" source)
    string(REPLACE "while ((p = ngcotouv(*pp)) != NULL && p->v >= level) {"
        "while (*pp != NULL && (p = ngcotouv(*pp))->v >= level) {" source "${source}")
    string(REPLACE "while ((uv = ngcotouv(L->openupval)) != NULL && uv->v >= level) {"
        "while (L->openupval != NULL && (uv = ngcotouv(L->openupval))->v >= level) {" source "${source}")
    string(SHA256 effective_hash "${source}")
    string(JSON expected_hash GET "${declaration}" effective_lfunc_sha256)
    if(NOT effective_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Native Lua upvalue adaptation differs from its declared two guards")
    endif()
    file(MAKE_DIRECTORY "${output_dir}/defined-upvalues")
    set(effective "${output_dir}/defined-upvalues/lfunc.c")
    if(EXISTS "${effective}")
        file(SHA256 "${effective}" existing_hash)
        if(NOT existing_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Generated Lua upvalue source differs; use a fresh build directory")
        endif()
    else()
        file(WRITE "${effective}" "${source}")
    endif()
    file(SHA256 "${lock}" lock_hash)
    string(JSON commit GET "${declaration}" source_commit)
    string(JSON archive_hash GET "${declaration}" archive_sha256)
    string(JSON original_hash GET "${declaration}" original_files_sha256 "lfunc.c")
    file(WRITE "${output_dir}/lua-source.json"
        "{\"schema\":1,\"source_commit\":\"${commit}\",\"archive_sha256\":\"${archive_hash}\",\"source_lock_sha256\":\"${lock_hash}\",\"original_inputs\":${count},\"original_lfunc_sha256\":\"${original_hash}\",\"effective_lfunc_sha256\":\"${effective_hash}\",\"changed_call_sites\":2,\"original_source_tree_unchanged\":true,\"windows_dependency_changed\":false}\n")
    set(${result} "${effective}" PARENT_SCOPE)
endfunction()
