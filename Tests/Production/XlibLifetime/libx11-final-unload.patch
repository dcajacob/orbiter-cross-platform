+/* Track only records created here. Arbitrary externally registered charsets
+ * remain borrowed; the registry does not acquire their storage ownership.
+ */
+typedef struct _OwnedCharSet {
+    XlcCharSetRec charset;
+    const char *name_storage;
+    const char *encoding_storage;
+    struct _OwnedCharSet *next;
+} OwnedCharSet;
+static OwnedCharSet *owned_charsets;
+typedef struct _OwnedCharSetString {
+    char *value;
+    struct _OwnedCharSetString *next;
+} OwnedCharSetString;
+static OwnedCharSetString *owned_charset_strings;
+
+/* Resource definitions can replace a shared charset's strings. Preserve every
+ * version until unload, including pointers borrowed by previously loaded locales.
+ */
+_X_HIDDEN Bool _XlcOwnCharSetString(char *value);
+Bool _XlcOwnCharSetString(char *value)
+{
+    OwnedCharSetString *owned = Xmalloc(sizeof(*owned));
+    if (!owned)
+        return False;
+    owned->value = value;
+    owned->next = owned_charset_strings;
+    owned_charset_strings = owned;
+    return True;
+}
