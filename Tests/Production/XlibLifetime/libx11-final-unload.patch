+/* Keep arena bases until the library's final unload. Returned pointers retain
+ * the original malloc alignment and remain valid for the entire loaded lifetime.
+ */
+typedef struct _PermAllocation {
+    char *base;
+    struct _PermAllocation *next;
+} PermAllocation;
+static PermAllocation *permAllocations;
+
+static char *tracked_permalloc(unsigned int length)
+{
+    char *base = Xmalloc(length);
+    PermAllocation *allocation;
+    if (!base)
+        return NULL;
+    allocation = Xmalloc(sizeof(*allocation));
+    if (!allocation) {
+        Xfree(base);
+        return NULL;
+    }
+    allocation->base = base;
+    allocation->next = permAllocations;
+    permAllocations = allocation;
+    return base;
+}
