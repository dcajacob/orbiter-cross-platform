  RPOS 4770488.27 4245945.37 -2122703.08
  RVEL 5242.970 -5610.802 567.655
  AROT -110.00 -15.00 -84.00
  IDS 0:1 100 1:2 100 2:3 100 3:4 100 4:5 100
  NAVFREQ 0 0
  XPDR 466
END
DG-01:DeltaGlider
