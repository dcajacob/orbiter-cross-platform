file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\n")
foreach(shader IN LISTS SHADERS)
    string(REPLACE "." "_" symbol "${shader}")
    file(READ "${SHADER_DIR}/${shader}.spv" contents HEX)
    string(REGEX REPLACE "(..)" "0x\\1," contents "${contents}")
    file(APPEND "${OUTPUT}" "inline constexpr std::uint8_t ${symbol}[] = {${contents}};\n")
endforeach()
